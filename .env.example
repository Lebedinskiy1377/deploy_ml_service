# Optional: copy to .env to override the defaults from docker-compose.yml.
POSTGRES_USER=pricing
POSTGRES_PASSWORD=pricing
POSTGRES_DB=pricing

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_ARTIFACT_BUCKET=mlflow

# Runs on the host instead of in Docker. The defaults in code already match
# the ports published by docker compose. The trainer reads .env by itself; for
# the API and scripts/seed_demo_db.py export it first: set -a; . ./.env; set +a
MLFLOW_TRACKING_URI=http://localhost:5001
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
